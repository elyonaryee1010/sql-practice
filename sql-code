   emp_id INT TEXT,
   NAME TEXT,
   dept_id TEXT,
    manager_id TEXT,alary_id DECIMAL(10,2),
  
   
);

INSERT INTO DEPARTMENT VALUES
('101', 'Employee1', 'ID01', 'MG01', 34.2),
